# Copy this file to `.env.local` and fill in real values.
# Next.js does NOT load `.env.example` — only `.env`, `.env.local`, etc.

# Opt out of Next.js anonymous telemetry (https://nextjs.org/telemetry)
NEXT_TELEMETRY_DISABLED=1

# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Where contact form messages are delivered
CONTACT_TO_EMAIL=you@example.com

# Optional. After verifying your domain in Resend, use e.g.:
# CONTACT_FROM=Zatn <contact@yourdomain.com>
# Until then, Resend's test sender works for development:
CONTACT_FROM=Zatn Website <onboarding@resend.dev>
